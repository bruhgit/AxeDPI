<Window x:Class="AxeDPI.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AxeDPI.UI.ViewModels"
        mc:Ignorable="d"
        Title="AxeDPI"
        Height="800" Width="660"
        MinHeight="700" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Smooth Window Entrance Animation -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootShell"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.3"
                                     DecelerationRatio="0.9"/>
                    <DoubleAnimation Storyboard.TargetName="RootTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="16.0" To="0.0"
                                     Duration="0:0:0.3"
                                     DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Outer Rounded Shell with Pitch-Black Backdrop and Subtle 1px Border -->
    <Border x:Name="RootShell"
            Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="16"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Integrated Titlebar -->
                <RowDefinition Height="*"/>  <!-- Main Panel -->
            </Grid.RowDefinitions>

            <!-- Minimalist Title Bar (Seamless, No colored bar) -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand: Pure AxeDPI -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ShieldSvg}"
                              Stroke="{StaticResource AccentWhiteBrush}"
                              StrokeThickness="2"
                              Fill="Transparent"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="2,0,12,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="AxeDPI" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource AccentWhiteBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Draggable Space -->
                    <Rectangle Grid.Column="1" Fill="Transparent"/>

                    <!-- Minimal Window Controls with Hover Transitions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button Click="BtnMinimize_Click" Width="32" Height="32" Margin="0,0,4,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <Path Data="{StaticResource MinusSvg}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1A1A1A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Close Button (Vibrant Red on Hover) -->
                        <Button Click="BtnClose_Click" Width="32" Height="32" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <Path x:Name="btnIcon" Data="{StaticResource CloseSvg}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                                        <Setter TargetName="btnIcon" Property="Stroke" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#C4101F"/>
                                                        <Setter TargetName="btnIcon" Property="Stroke" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Scrollable Body with Clean Floating Dark Scrollbar -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,6,14,16" Margin="0,0,4,8">
                <StackPanel>

                    <!-- MASTER TOGGLE CARD (Clean, Hand-Crafted AxeSwitch) -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <!-- Animated Breathing Status Dot -->
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#444444"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource ActiveEmeraldBrush}"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="PulseStoryboard">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1.0" To="0.35"
                                                                                     Duration="0:0:0.9"
                                                                                     DecelerationRatio="0.5"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Fill" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="DPI Bypass" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <!-- Paused indicator badge -->
                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" Background="#261E05" BorderBrush="#5B4309" BorderThickness="1" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRunning}" Value="True"/>
                                                            <Condition Binding="{Binding IsPaused}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="PAUSED" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusDescription}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Custom AxeSwitch and Pause Control -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Pause Button (Visible when running) -->
                                <Button Command="{Binding TogglePauseCommand}" Margin="0,0,12,0" Height="28" Padding="10,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="{StaticResource CardInnerBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path x:Name="btnIcon" Data="{StaticResource PauseSvg}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                                                <TextBlock x:Name="btnText" Text="{Binding PauseActionText}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter TargetName="btnIcon" Property="Data" Value="{StaticResource PlaySvg}"/>
                                                                <Setter TargetName="btnIcon" Property="Fill" Value="#F59E0B"/>
                                                                <Setter TargetName="btnText" Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <ToggleButton Command="{Binding ToggleServiceCommand}"
                                              IsChecked="{Binding IsRunning, Mode=OneWay}"
                                              Style="{StaticResource AxeSwitchStyle}"
                                              VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FUNCTIONAL CONTROLS CARD (Rounded Group) -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="0"
                            Margin="0,0,0,14">
                        <StackPanel>

                            <!-- Row 1: System Proxy with Custom AxeSwitch -->
                            <Border Padding="18,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="System Proxy" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Route Windows browser and app traffic through 127.0.0.1:10808" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Command="{Binding ToggleSystemProxyCommand}"
                                                  IsChecked="{Binding IsSystemProxyActive, Mode=OneWay}"
                                                  Style="{StaticResource AxeSwitchStyle}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Row 2: Discord Launcher -->
                            <Border Padding="18,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Discord Bypass" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Relaunches Discord with --proxy-server flag" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding LaunchDiscordCommand}"
                                            Height="32" Padding="14,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource CardInnerBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                                                    <Path Data="{StaticResource DiscordSvg}" Fill="{StaticResource TextPrimaryBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="Launch" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#222222"/>
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Row 3: Windows Startup with Custom AxeSwitch -->
                            <Border Padding="18,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Launch on Startup" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Start silently in background when Windows boots" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Command="{Binding ToggleStartupCommand}"
                                                  IsChecked="{Binding IsStartupActive, Mode=OneWay}"
                                                  Style="{StaticResource AxeSwitchStyle}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Row 4: DoH Diagnostic Ping -->
                            <Border Padding="18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DNS over HTTPS (DoH)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Encrypted resolution via Cloudflare &amp; Google" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBox Grid.Column="1" Text="{Binding DohTestDomain, UpdateSourceTrigger=PropertyChanged}" Margin="10,0"/>

                                        <Button Grid.Column="2" Command="{Binding TestDohCommand}" Height="34" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource CardInnerBgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                                    <TextBlock Text="Test" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#222222"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <!-- Latency / Resolved IP summary text -->
                                    <TextBlock Grid.Row="1" Text="{Binding DohTestResult}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- EXCLUDED APPLICATIONS DRAWER -->
                    <Expander Background="{StaticResource CardBgBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              BorderThickness="1"
                              Margin="0,0,0,14">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                                <StackPanel>
                                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="20,16">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Path Grid.Column="0" Data="{StaticResource AppWindowSvg}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="Excluded Applications" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <Border Grid.Column="2" Background="#1C1C1C" CornerRadius="6" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ExcludedApps.Count, StringFormat='{}{0} apps'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                        </Border>
                                                                        <Path Grid.Column="3" Data="{StaticResource ChevronDownSvg}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="0"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                            <DataTrigger.EnterActions>
                                                                                                <BeginStoryboard>
                                                                                                    <Storyboard>
                                                                                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2"/>
                                                                                                    </Storyboard>
                                                                                                </BeginStoryboard>
                                                                                            </DataTrigger.EnterActions>
                                                                                            <DataTrigger.ExitActions>
                                                                                                <BeginStoryboard>
                                                                                                    <Storyboard>
                                                                                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2"/>
                                                                                                    </Storyboard>
                                                                                                </BeginStoryboard>
                                                                                            </DataTrigger.ExitActions>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>

                                                    <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="20,0,20,18" Opacity="0">
                                                        <ContentPresenter.RenderTransform>
                                                            <TranslateTransform x:Name="ExpandTranslate" Y="-10"/>
                                                        </ContentPresenter.RenderTransform>
                                                    </ContentPresenter>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.0" To="1.0"
                                                                                 Duration="0:0:0.22"
                                                                                 DecelerationRatio="0.9"/>
                                                                <DoubleAnimation Storyboard.TargetName="ExpandTranslate"
                                                                                 Storyboard.TargetProperty="Y"
                                                                                 From="-12.0" To="0.0"
                                                                                 Duration="0:0:0.22"
                                                                                 DecelerationRatio="0.9"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Expander.Style>

                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Outbound connections from these executables bypass DPI packet fragmentation entirely."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Input Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding NewExcludedAppText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddExcludedAppCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="1" Command="{Binding AddExcludedAppCommand}" Height="34" Padding="14,0" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource CardInnerBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                                                                <Path Data="{StaticResource PlusSvg}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                                                <TextBlock Text="Add" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding BrowseAndAddAppCommand}" Height="34" Padding="12,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{StaticResource CardInnerBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                                                <Path Data="{StaticResource FolderSvg}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                                                <TextBlock Text="Browse..." FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#444444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Excluded Apps List -->
                            <Border Background="#070707" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" MinHeight="70" MaxHeight="160">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                                    <ItemsControl ItemsSource="{Binding ExcludedApps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141414" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,2" Padding="10,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Path Grid.Column="0" Data="{StaticResource AppWindowSvg}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" FontFamily="Consolas, Cascadia Code, monospace"/>

                                                        <Button Grid.Column="2"
                                                                Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="22" Height="22" Cursor="Hand">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                                    <Path x:Name="icon" Data="{StaticResource CloseSvg}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="border" Property="Background" Value="#331111"/>
                                                                                        <Setter TargetName="icon" Property="Stroke" Value="#FF6B6B"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- SETTINGS DRAWER WITH CUSTOM AXESLIDERS (Smooth Animated Reveal) -->
                    <Expander Background="{StaticResource CardBgBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              BorderThickness="1"
                              Margin="0,0,0,14">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                                <StackPanel>
                                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="20,16">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Path Data="{StaticResource SlidersSvg}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="Engine Parameters" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <Path Grid.Column="2" Data="{StaticResource ChevronDownSvg}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="0"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                            <DataTrigger.EnterActions>
                                                                                                <BeginStoryboard>
                                                                                                    <Storyboard>
                                                                                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2"/>
                                                                                                    </Storyboard>
                                                                                                </BeginStoryboard>
                                                                                            </DataTrigger.EnterActions>
                                                                                            <DataTrigger.ExitActions>
                                                                                                <BeginStoryboard>
                                                                                                    <Storyboard>
                                                                                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2"/>
                                                                                                    </Storyboard>
                                                                                                </BeginStoryboard>
                                                                                            </DataTrigger.ExitActions>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>

                                                    <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="20,0,20,18" Opacity="0">
                                                        <ContentPresenter.RenderTransform>
                                                            <TranslateTransform x:Name="ExpandTranslate" Y="-10"/>
                                                        </ContentPresenter.RenderTransform>
                                                    </ContentPresenter>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.0" To="1.0"
                                                                                 Duration="0:0:0.22"
                                                                                 DecelerationRatio="0.9"/>
                                                                <DoubleAnimation Storyboard.TargetName="ExpandTranslate"
                                                                                 Storyboard.TargetProperty="Y"
                                                                                 From="-12.0" To="0.0"
                                                                                 Duration="0:0:0.22"
                                                                                 DecelerationRatio="0.9"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Expander.Style>

                        <StackPanel Margin="0,6,0,0">
                            <!-- Custom Range Slider 1: TLS Split Position -->
                            <Border Background="{StaticResource CardInnerBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="TLS Client Hello Split Position" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border HorizontalAlignment="Right" Background="#222222" CornerRadius="6" Padding="8,2">
                                            <TextBlock Text="{Binding SplitPos, StringFormat='{}{0} bytes'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentWhiteBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="2" Maximum="120" Value="{Binding SplitPos, Mode=TwoWay}"
                                            Style="{StaticResource AxeSliderStyle}" Margin="0,4,0,2"/>
                                    <TextBlock Text="Offsets dynamic SNI fragmentation point (Default: 40 bytes)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Custom Range Slider 2: Segment Delay -->
                            <Border Background="{StaticResource CardInnerBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="TCP Segment Inter-Packet Delay" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border HorizontalAlignment="Right" Background="#222222" CornerRadius="6" Padding="8,2">
                                            <TextBlock Text="{Binding SplitDelayMs, StringFormat='{}{0} ms'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentWhiteBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="50" Value="{Binding SplitDelayMs, Mode=TwoWay}"
                                            Style="{StaticResource AxeSliderStyle}" Margin="0,4,0,2"/>
                                    <TextBlock Text="Forces OS to flush fragments into separate TCP packets (Default: 10 ms)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Network Port & Upstream Proxy Row -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Port" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BindPort, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Upstream Proxy URL (Optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding UpstreamProxy, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- ACTIVITY LOG (Clean Terminal Box) -->
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource TerminalSvg}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Console" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" Padding="6,2">
                                                            <Path Data="{StaticResource TrashSvg}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Terminal Viewport (Zero Blue Borders) -->
                            <Border Background="#070707" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Height="150">
                                <ListBox ItemsSource="{Binding LogMessages}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#888888"
                                         FontFamily="Consolas, Cascadia Code, monospace"
                                         FontSize="11.5"
                                         FocusVisualStyle="{x:Null}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Padding="8,6">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="4" Padding="6,2">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="itemBorder" Property="Background" Value="#1A1A1A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="itemBorder" Property="Background" Value="#121212"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
